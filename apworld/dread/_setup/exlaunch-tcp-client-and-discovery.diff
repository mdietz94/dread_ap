+    // Simple substring search (devkitPro's libc lacks memmem). Returns the
+    // start of the first match or nullptr.
+    const char* FindSubstr(const char* hay, size_t hayLen,
+                           const char* needle, size_t needleLen) {
+        if (needleLen == 0 || hayLen < needleLen) return nullptr;
+        const size_t last = hayLen - needleLen;
+        for (size_t i = 0; i <= last; ++i) {
+            if (memcmp(hay + i, needle, needleLen) == 0) return hay + i;

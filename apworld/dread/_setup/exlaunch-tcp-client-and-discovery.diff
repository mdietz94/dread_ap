+    // Wait up to timeoutMs for a UDP reply on `fd`. On success fills `buf`
+    // (up to bufCap bytes) and `gotOut`; sender address discarded.
+    bool WaitUdpReply(s32 fd, char* buf, size_t bufCap,
+                      ssize_t& gotOut, s32 timeoutMs) {
+        ::pollfd pfd{};
+        pfd.fd = fd;
+        pfd.events = PollEvIn;
+        pfd.revents = 0;
+        s32 n = nn::socket::Poll(&pfd, 1, timeoutMs);
+        if (n <= 0) return false;
+        if (pfd.revents & (PollEvErr | PollEvHup)) return false;
+        if (!(pfd.revents & PollEvIn)) return false;
+        struct sockaddr_in from{};
+        u32 fromLen = sizeof(from);
+        ssize_t got = nn::socket::RecvFrom(fd, buf, bufCap, 0,
+                                            reinterpret_cast<struct sockaddr*>(&from),
+                                            &fromLen);
+        if (got <= 0) return false;
+        gotOut = got;
+        return true;

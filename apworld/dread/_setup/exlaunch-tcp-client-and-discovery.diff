+#pragma once
+
+// Bake-time configuration for the bridge discovery sweep.
+//
+// DEFAULT_BRIDGE_SUBNET is an IPv4 literal used as the seed for the /24
+// sweep in remote_api.cpp: the Switch unicasts a JSON discovery probe to
+// every host on the seed's /24, then takes the first {"t":"bridge"} reply.
+// Loopback (127.0.0.1) is tried before the sweep, so this value only
+// matters when the PC running DreadClient is reachable on a real LAN
+// (i.e. not Ryujinx-on-same-host).
+//
+// The /setup wizard's BridgeIpPage rewrites this header to the user's
+// PC LAN IP before each build. The default below ships when no wizard
+// customization has happened (headless CLI build or a fresh checkout
+// the user hasn't run setup against yet); 192.168.1.1 is a reasonable
+// guess for residential SOHO routers and at worst causes the sweep to
+// return no reply and the next attempt to fall through to the loopback
+// probe (which is the only viable path in that scenario anyway).
+//
+// The wizard owns rewrites of this file. The patch only ships defaults.
+
+#ifndef DEFAULT_BRIDGE_SUBNET
+#define DEFAULT_BRIDGE_SUBNET "192.168.1.1"
+#endif

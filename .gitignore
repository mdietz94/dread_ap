# ============================================================================
# Generated rule artifact — produced by scripts/extract_dread_rules.py from
# the .dread-cache logic JSON. Gitignored to keep PRs lean; tests auto-regen
# via apworld/dread/tests/conftest.py and scripts/install_apworld.py bundles
# it into the .apworld zip for end users.
# ============================================================================
apworld/dread/data/logic_graph.json

# Prebuilt sysmodule staged into the apworld at package time by
# scripts/install_apworld.py (subsdk9 has no extension; main.npdm is also
# covered by the *.npdm rule above). Build outputs, never committed.
apworld/dread/data/sysmodule/

# ============================================================================
# Test scratch
# ============================================================================
apworld/dread/tests/seeds/out/
.pytest_cache/
.coverage
htmlcov/

# ============================================================================
# Worktrees — gitignored but checked out under here for parallel work
# ============================================================================
third_party/

# ============================================================================
# Vendored upstream Randovania repos.
#
# - `vendor/open-dread-rando/` is a pinned git SUBMODULE (GPL-3.0). Carries the
#   patcher source; install_apworld.py copies it into the apworld zip so end
#   users do not need to `pip install open-dread-rando`. Clone with
#   `git clone --recurse-submodules`, or run `git submodule update --init`.
# - `vendor/open-dread-rando-exlaunch/` stays gitignored — GPL-2.0, dev-only
#   reference clone. Our two local patches live at
#   `apworld/dread/_setup/exlaunch-*.diff` and are applied by
#   `apworld/dread/_setup/build.py` against a user-side clone.
# vendor/CHANGES.md (tracked) documents the diffs we carry.
# ============================================================================
vendor/open-dread-rando-exlaunch/

# ============================================================================
# Local plan notes Claude Code drops in here during planning mode.
# ============================================================================
.claude/
